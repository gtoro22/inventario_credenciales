# Copia a .env.docker (NO lo subas al repositorio) y completa los valores.
#   docker compose --env-file .env.docker up -d --build

# Generar:  php artisan key:generate --show      (o: docker run --rm php:8.3-cli php -r 'echo "base64:".base64_encode(random_bytes(32)),"\n";')
APP_KEY=
# Generar:  php artisan credentials:generate-key  (misma forma: base64:<32 bytes>). RESPÁLDALA aparte: sin ella los secretos no se recuperan.
VAULT_KEY=
VAULT_PREVIOUS_KEYS=

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
WEB_PORT=8080
# Pon true cuando sirvas por HTTPS
SESSION_SECURE_COOKIE=false

DB_DATABASE=credential_vault
DB_USERNAME=vault
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Migra y siembra roles/permisos al arrancar (idempotente)
AUTO_MIGRATE=true
